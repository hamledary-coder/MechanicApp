<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.Mechanic.Workshop">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_pending"
        android:label="Mechanic"
        android:theme="@style/Theme.MechanicApp"
        android:usesCleartextTraffic="true">

        <activity android:name=".ui.auth.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.home.HomeActivity" />
        <activity android:name=".ui.cartable.CartableActivity" />
        <activity android:name=".ui.task.create.CreateTaskActivity" />
        <activity android:name=".ui.task.detail.TaskDetailActivity" />
    </application>
</manifest>