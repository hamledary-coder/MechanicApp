<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:id="@+id/cardLog"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: خلاصه گزارش + فلش (راست) + سه نقطه (چپ) - استاندارد RTL -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:background="?attr/selectableItemBackground">

            <!-- سه نقطه در سمت چپ -->
            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_more_vert"
                android:layout_marginEnd="8dp"/>

            <!-- متن خلاصه گزارش (گرفتن فضای باقیمانده) -->
            <TextView
                android:id="@+id/tvLogSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="گزارش ۱۴۰۴/۰۲/۲۵ - علی رضایی"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="start"/>

            <!-- فلش اکسپند در سمت راست -->
            <ImageView
                android:id="@+id/ivExpand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_down"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:visibility="gone"/>

        <!-- جزئیات کامل گزارش (در حالت باز) -->
        <LinearLayout
            android:id="@+id/detailLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvActionDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="شرح اقدام: ..."
                android:layout_marginBottom="8dp"/>

            <View
                android:id="@+id/dividerDescription"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:visibility="visible" />


            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مدت زمان: ..."
                android:textSize="14sp"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvWorkers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="گروه: ..."
                android:layout_marginBottom="4dp"/>

            <View
                android:id="@+id/dividerStatus"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:visibility="visible" />


            <TextView
                android:id="@+id/tvNewStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="وضعیت جدید: ..."
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvLogNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="توضیحات: ..."
                android:visibility="gone"/>

            <!-- ✅ تیک‌های رنگی -->
            <LinearLayout
                android:id="@+id/seenByContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="8dp" />

            <!-- بخش نظرات -->
            <TextView
                android:id="@+id/tvCommentLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="نظرات:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAddComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ثبت نظر"
                android:backgroundTint="#FF9800"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>