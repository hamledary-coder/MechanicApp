<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="8dp"
    android:background="@drawable/card_background"
    android:elevation="2dp">

    <!-- Header (قسمت بالایی - همیشه可見) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/tvTaskId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="شماره: 123"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="عنوان کار"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivExpand"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/arrow_down_float" />

    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:visibility="gone" />

    <!-- Detail (قسمت پایینی - فقط در حالت باز دیده می‌شود) -->
    <LinearLayout
        android:id="@+id/detailLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="توضیحات: ..."
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvTaskResponsible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مسئول: ..."
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTaskAssignees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="انجام‌دهندگان: ..."
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- واحد و زیرمجموعه در یک ردیف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvTaskUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="واحد: ..."
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTaskSubUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="زیرمجموعه: ..."
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTaskPriority"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="اهمیت: ..."
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- تاریخ اعلام -->
        <TextView
            android:id="@+id/tvRequestDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تاریخ اعلام: ..."
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- صادرکننده درخواست -->
        <TextView
            android:id="@+id/tvRequester"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="صادرکننده: ..."
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- نحوه اعلام -->
        <TextView
            android:id="@+id/tvDeclarationMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نحوه اعلام: ..."
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- شماره سامانه -->
        <TextView
            android:id="@+id/tvSystemNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="شماره سامانه: ..."
            android:textSize="14sp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- بررسی اولیه -->
        <TextView
            android:id="@+id/tvInitialReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بررسی اولیه: ..."
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- آیکون‌های عملیاتی -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/icEdit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_edit"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FF9800" />

            <ImageView
                android:id="@+id/icDelete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_delete"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#F44336" />

            <ImageView
                android:id="@+id/icRefer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_refer"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/blue_500" />

            <ImageView
                android:id="@+id/icVolunteer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_volunteer"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#4CAF50" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>