<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:layoutDirection="rtl">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#2E7D32"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- شرح اقدام (اجباری) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="شرح اقدام انجام شده *"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etActionDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="مثال: پمپ را باز کردم، واشر تعویض شد..."
                android:gravity="top"
                android:inputType="textMultiLine"
                android:background="@android:drawable/editbox_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- تاریخ انجام -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تاریخ انجام *"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="۱۴۰۴/۰۲/۲۵"
                android:focusable="false"
                android:cursorVisible="false"
                android:background="@android:drawable/editbox_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- زمان شروع و پایان در یک ردیف -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="زمان شروع"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etStartTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="۰۹:۰۰"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:background="@android:drawable/editbox_background"
                        android:padding="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="زمان پایان"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etEndTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="۱۲:۰۰"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:background="@android:drawable/editbox_background"
                        android:padding="12dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- قطعات مصرفی -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="قطعات مصرفی"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etParts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="مثال: واشر 2 عدد، بلبرینگ 1 عدد"
                android:background="@android:drawable/editbox_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- گروه انجام‌دهنده + دکمه ویرایش -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="گروه انجام‌دهنده"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvGroupValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="در حال بارگیری..."
                    android:padding="12dp"
                    android:background="@android:drawable/editbox_background" />

                <Button
                    android:id="@+id/btnEditGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ویرایش"
                    android:backgroundTint="#FF9800"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- وضعیت جدید کار -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="وضعیت جدید کار *"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerNewStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

            <!-- توضیحات تکمیلی -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="توضیحات تکمیلی"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="توضیحات اضافی..."
                android:gravity="top"
                android:inputType="textMultiLine"
                android:background="@android:drawable/editbox_background"
                android:padding="12dp"
                android:layout_marginBottom="24dp" />

            <!-- دکمه‌ها -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="32dp">

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="ثبت گزارش"
                    android:backgroundTint="#2E7D32" />

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="انصراف"
                    android:backgroundTint="#9E9E9E" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>