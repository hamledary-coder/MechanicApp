<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="شرایط محیط کار"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- گرمای هوا -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="دمای محیط کار"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvHeatMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekBarHeat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="20" />  <!-- 0 تا 20 = 30 تا 50 درجه -->

        <TextView
            android:id="@+id/tvHeatMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvHeatValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مقدار فعلی: 30 درجه"
        android:textSize="12sp"
        android:textColor="#2E7D32"
        android:layout_marginBottom="16dp" />

    <!-- آلودگی محل کار -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="آلودگی محیط کار"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvPollutionMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekBarPollution"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="100" />

        <TextView
            android:id="@+id/tvPollutionMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvPollutionValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مقدار فعلی: 0 ppm"
        android:textSize="12sp"
        android:textColor="#2E7D32"
        android:layout_marginBottom="16dp" />

    <!-- نوع کار -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="نوع کار"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerWorkType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/editbox_background"
        android:padding="8dp"
        android:layout_marginBottom="16dp" />

    <!-- دکمه اعمال به همه -->
    <Button
        android:id="@+id/btnApplyToAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اعمال به همه گزارش‌های این کار"
        android:backgroundTint="#2196F3"
        android:layout_marginBottom="8dp" />

    <!-- دکمه تأیید و انصراف -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="تأیید"
            android:backgroundTint="#2E7D32" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="انصراف"
            android:backgroundTint="#9E9E9E" />

    </LinearLayout>

</LinearLayout>