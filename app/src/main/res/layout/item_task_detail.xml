<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ردیف ۱: شماره کار و عنوان کار -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTaskId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۱۰۰۱"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#E8F5E9"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="عنوان کار"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- ردیف ۲: مسئول انجام کار -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مسئول انجام کار:"
                android:textColor="#757575"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvTaskResponsible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="علی رضایی"
                android:textColor="#6200EE"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- ردیف ۳: گروه انجام دهنده -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="گروه انجام دهنده:"
                android:textColor="#757575"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvTaskAssignees"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="رضا محمدی، حسن کریمی، زهرا احمدی"
                android:textColor="#424242"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- ردیف ۴: آخرین وضعیت و تاریخ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvTaskStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="در حال انجام"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTaskUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="گاز"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="#E0E0E0"/>

            <TextView
                android:id="@+id/tvTaskPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_priority_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="اورژانسی"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>