<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:layoutDirection="rtl"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- شماره کار -->
        <TextView
            android:id="@+id/tvTaskId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="شماره کار: 1001"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#E8F5E9"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- عنوان کار -->
        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عنوان کار"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="12dp"/>

        <!-- شرح کار -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="شرح کار:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#757575"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="توضیحات کامل کار در این قسمت نمایش داده می‌شود..."
            android:textSize="16sp"
            android:textColor="#424242"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="16dp"/>

        <!-- واحد مربوطه و درجه اهمیت -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTaskUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="واحد: گاز"
                android:textSize="18sp"
                android:textColor="#757575"
                android:gravity="start"/>

            <TextView
                android:id="@+id/tvTaskPriority"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="اهمیت: اورژانسی"
                android:textSize="18dp"
                android:textColor="#757575"
                android:gravity="end"/>
        </LinearLayout>

        <!-- ایجاد کننده -->
        <TextView
            android:id="@+id/tvTaskCreator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ایجاد کننده: علی رضایی"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp"/>

        <!-- تاریخ ایجاد -->
        <TextView
            android:id="@+id/tvTaskDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تاریخ: ۱۴۰۲/۱۲/۲۴"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="16dp"/>

        <!-- مسئول انجام کار (در صورت وجود) -->
        <TextView
            android:id="@+id/tvTaskResponsible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مسئول: رضا محمدی"
            android:textSize="14sp"
            android:textColor="#6200EE"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <!-- گروه انجام دهنده (در صورت وجود) -->
        <TextView
            android:id="@+id/tvTaskAssignees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="انجام‌دهندگان: حسن کریمی، زهرا احمدی"
            android:textSize="14sp"
            android:textColor="#424242"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>