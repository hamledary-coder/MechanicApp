<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- شماره کار -->
    <TextView
        android:id="@+id/tvTaskId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="شماره کار: 1234"
        android:textColor="#2E7D32"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#E8F5E9"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="12dp" />

    <!-- عنوان کار -->
    <TextView
        android:id="@+id/tvTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="عنوان: تعمیر پمپ TA-5"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="8dp" />

    <!-- شرح کار -->
    <TextView
        android:id="@+id/tvTaskDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="شرح: ..."
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginBottom="12dp" />

    <!-- مسئول -->
    <TextView
        android:id="@+id/tvTaskResponsible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مسئول: علی رضایی"
        android:textSize="14sp"
        android:textColor="#6200EE"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- گروه انجام‌دهنده -->
    <TextView
        android:id="@+id/tvTaskAssignees"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="گروه: رضا، محمد، حسن"
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- واحد -->
    <TextView
        android:id="@+id/tvTaskUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="واحد: بهره‌برداری"
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- اولویت/اهمیت -->
    <TextView
        android:id="@+id/tvTaskUrgency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اهمیت: بالا"
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- تاریخ اعلام -->
    <TextView
        android:id="@+id/tvRequestDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تاریخ اعلام: ۱۴۰۴/۰۲/۲۵"
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- صادرکننده -->
    <TextView
        android:id="@+id/tvRequester"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="صادرکننده: ..."
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- نحوه اعلام -->
    <TextView
        android:id="@+id/tvDeclarationMethod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="نحوه اعلام: ..."
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- شماره سامانه -->
    <TextView
        android:id="@+id/tvSystemNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="شماره سامانه: ..."
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- بررسی اولیه -->
    <TextView
        android:id="@+id/tvInitialReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="بررسی اولیه: ..."
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvReferredBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ارجاع‌دهنده: ..."
        android:textSize="14sp"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

</LinearLayout>